<Window
    x:Class="Pixwall.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="pixwall の設定">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- 文字は x:Uid で Strings/<言語>/Resources.resw から引く。ここに書いた日本語は、引けなかったときのもの -->
    <Grid>
        <Grid.Resources>
            <!-- Windows の設定アプリと同じ、角の丸いカードの行 -->
            <Style x:Key="Card" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>
            <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="4,20,0,6" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 題名の帯も窓の中身として描く（タスクマネージャーや設定アプリと同じ、境目の無い見た目） -->
        <TitleBar x:Uid="AppTitleBar" x:Name="AppTitleBar" Title="pixwall の設定" />

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="640" Padding="24,16,24,24" Spacing="4">
                <!-- 自動で合わなかったときのために、一番上に置く -->
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="RefreshLabel" Text="壁紙が画面に合っていないとき" VerticalAlignment="Center" />
                    <Button x:Uid="RefreshButton" Grid.Column="1" Content="表示を更新" Click="Refresh_Click" />
                </Grid>

                <TextBlock x:Uid="ImageHeading" Text="画像" Style="{StaticResource Heading}" />
                <Grid Style="{StaticResource Card}" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="AllDisplays" Text="すべての画面" />
                        <TextBlock x:Name="ImageName" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Uid="ChooseButton" Grid.Column="1" Content="選ぶ…" Click="ChooseImage_Click" VerticalAlignment="Center" />
                    <TextBlock x:Name="LoadError" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                    <Image x:Name="Preview" Grid.Row="2" Grid.ColumnSpan="2" MaxHeight="160" Stretch="Uniform"
                           HorizontalAlignment="Center" Visibility="Collapsed" />
                </Grid>
                <!-- pixwall が動いていないときにも、同じ見た目を静止画で壁紙にできるように -->
                <Grid Style="{StaticResource Card}" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="StillLabel" Text="静止画" />
                        <TextBlock x:Name="FrameLabel" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Uid="ExportButton" x:Name="ExportButton" Grid.Column="1" Content="静止画を書き出す…" Click="Export_Click"
                            VerticalAlignment="Center" />
                    <Slider x:Uid="FrameSliderControl" x:Name="FrameSlider" AutomationProperties.Name="書き出す絵" Grid.Row="1" Grid.ColumnSpan="2"
                            Minimum="0" Maximum="0" StepFrequency="1" ValueChanged="Frame_Changed" />
                    <TextBlock x:Name="ExportResult" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed"
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                </Grid>

                <TextBlock x:Uid="DisplayHeading" Text="表示" Style="{StaticResource Heading}" />
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Fit" Text="並べ方" VerticalAlignment="Center" />
                    <!-- 並び順は MainWindow.xaml.cs の Fits とそろえる -->
                    <ComboBox x:Uid="FitControl" x:Name="FitBox" AutomationProperties.Name="並べ方" Grid.Column="1" MinWidth="180" SelectionChanged="Fit_Changed">
                        <ComboBoxItem x:Uid="FitInteger" Content="整数倍で最大" />
                        <ComboBoxItem x:Uid="FitFit" Content="画面に合わせる" />
                        <ComboBoxItem x:Uid="FitFill" Content="画面を埋める" />
                        <ComboBoxItem x:Uid="FitFree" Content="自由に置く" />
                    </ComboBox>
                </Grid>
                <!-- 画面に合わせる・埋めるときだけ出す。余白（埋めるときははみ出し）が上下にできる画面では上下、左右にできる画面では左右に動く -->
                <Grid x:Name="PositionCard" Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="Position" Text="位置" />
                        <TextBlock x:Uid="PositionHint" Text="0 で上・左、100 で下・右" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Slider x:Uid="PositionControl" x:Name="PositionSlider" AutomationProperties.Name="位置" Grid.Column="1" Width="180" Minimum="0" Maximum="100"
                            StepFrequency="1" TickFrequency="50" TickPlacement="Outside" SnapsTo="StepValues" IsThumbToolTipEnabled="False"
                            VerticalAlignment="Center" ValueChanged="Position_Changed" />
                    <TextBlock x:Name="PositionLabel" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
                <!-- 自由に置くときだけ出す。大きさと横・縦の位置を別々に決める -->
                <StackPanel x:Name="FreeCards" Spacing="4">
                    <Grid Style="{StaticResource Card}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="FreeSize" Text="大きさ" />
                            <TextBlock x:Uid="FreeSizeHint" Text="100% で画面に合わせた大きさ" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Slider x:Uid="FreeSizeControl" x:Name="FreeSizeSlider" AutomationProperties.Name="大きさ" Grid.Column="1" Width="180" Minimum="10" Maximum="300"
                                StepFrequency="1" TickFrequency="90" TickPlacement="Outside" SnapsTo="StepValues" IsThumbToolTipEnabled="False"
                                VerticalAlignment="Center" ValueChanged="Free_Changed" />
                        <TextBlock x:Name="FreeSizeLabel" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                    <Grid Style="{StaticResource Card}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="FreeX" Text="横の位置" />
                            <TextBlock x:Uid="FreeXHint" Text="0 で左の端、100 で右の端" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Slider x:Uid="FreeXControl" x:Name="FreeXSlider" AutomationProperties.Name="横の位置" Grid.Column="1" Width="180" Minimum="0" Maximum="100"
                                StepFrequency="1" TickFrequency="50" TickPlacement="Outside" SnapsTo="StepValues" IsThumbToolTipEnabled="False"
                                VerticalAlignment="Center" ValueChanged="Free_Changed" />
                        <TextBlock x:Name="FreeXLabel" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                    <Grid Style="{StaticResource Card}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="FreeY" Text="縦の位置" />
                            <TextBlock x:Uid="FreeYHint" Text="0 で上の端、100 で下の端" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Slider x:Uid="FreeYControl" x:Name="FreeYSlider" AutomationProperties.Name="縦の位置" Grid.Column="1" Width="180" Minimum="0" Maximum="100"
                                StepFrequency="1" TickFrequency="50" TickPlacement="Outside" SnapsTo="StepValues" IsThumbToolTipEnabled="False"
                                VerticalAlignment="Center" ValueChanged="Free_Changed" />
                        <TextBlock x:Name="FreeYLabel" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                </StackPanel>
                <!-- 余白と、画像の透明なところの色 -->
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="Background" Text="余白の色" />
                        <TextBlock x:Uid="BackgroundHint" Text="自動では画像の左上の色" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <!-- 自分で選ぶときだけ出す。押すと色を選ぶ画面が開く -->
                    <Button x:Uid="ColorButtonControl" x:Name="ColorButton" AutomationProperties.Name="色を選ぶ" Grid.Column="1" Padding="4"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <Border x:Name="ColorSwatch" Width="40" Height="20" CornerRadius="2"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="BackgroundPicker" IsAlphaEnabled="False" IsMoreButtonVisible="True"
                                             ColorChanged="Background_ColorChanged" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <ComboBox x:Uid="BackgroundControl" x:Name="BackgroundBox" AutomationProperties.Name="余白の色" Grid.Column="2" MinWidth="140"
                              VerticalAlignment="Center" SelectionChanged="Background_Changed">
                        <ComboBoxItem x:Uid="BackgroundAuto" Content="自動" />
                        <ComboBoxItem x:Uid="BackgroundCustom" Content="自分で選ぶ" />
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Speed" Text="速さ" VerticalAlignment="Center" />
                    <!-- 0.25・0.5・1・2・4 倍の5段。つまみは 2 の何乗かで動かす -->
                    <Slider x:Uid="SpeedControl" x:Name="SpeedSlider" AutomationProperties.Name="速さ" Grid.Column="1" Width="180" Minimum="-2" Maximum="2" StepFrequency="1"
                            TickFrequency="1" TickPlacement="Outside" SnapsTo="StepValues" IsThumbToolTipEnabled="False"
                            VerticalAlignment="Center" ValueChanged="Speed_Changed" />
                    <TextBlock x:Name="SpeedLabel" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>

                <TextBlock x:Uid="PauseHeading" Text="止める" Style="{StaticResource Heading}" />
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="LowPower" Text="省エネモードのときは止める" VerticalAlignment="Center" />
                    <ToggleSwitch x:Uid="LowPowerControl" x:Name="LowPowerSwitch" AutomationProperties.Name="省エネモードのときは止める" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="LowPower_Toggled" />
                </Grid>
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Pause" Text="一時停止" VerticalAlignment="Center" />
                    <ToggleSwitch x:Uid="PauseControl" x:Name="PauseSwitch" AutomationProperties.Name="一時停止" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="Pause_Toggled" />
                </Grid>

                <TextBlock x:Uid="StartupHeading" Text="起動" Style="{StaticResource Heading}" />
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Login" Text="ログイン時に起動" VerticalAlignment="Center" />
                    <ToggleSwitch x:Uid="LoginControl" x:Name="LoginSwitch" AutomationProperties.Name="ログイン時に起動" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="Login_Toggled" />
                </Grid>
                <Grid Style="{StaticResource Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="QuitLabel" Text="壁紙を止めて、OS の壁紙に戻す" VerticalAlignment="Center" />
                    <Button x:Uid="QuitButton" Grid.Column="1" Content="pixwall を終了" Click="Quit_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
